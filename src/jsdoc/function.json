{
	"@param": {
		"prefix": ["@param", "@arg", "@argument"],
		"body": ["@param {${1:TYPE}} ${2:name} - ${3:description}"],
		"description": "Document a function parameter.\nJSDoc lists `@arg` / `@argument` as synonyms; this inserts the primary form.\n\nType syntax:\n- Nullable: `{?number}`   Non-nullable: `{!Object}`\n- Union: `{number|string}`   Any: `{*}`\n- Rest: `{...number}`   Optional: `[param]`   Default: `[param=10]`\n- Function: `{function(a: number): boolean}`\n- Generic: `{Map<number, string>}`   Record: `{{a: number, b: string}}`\nhttps://jsdoc.app/tags-param\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@param optional": {
		"prefix": "@param.optional",
		"body": ["@param {${1:TYPE}} [${2:name}] - ${3:description}"],
		"description": "An optional parameter — the name goes in square brackets.\nhttps://jsdoc.app/tags-param\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@param with default": {
		"prefix": "@param.default",
		"body": ["@param {${1:TYPE}} [${2:name}=${3:defaultValue}] - ${4:description}"],
		"description": "An optional parameter with a default value.\nhttps://jsdoc.app/tags-param\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@param is an Array": {
		"prefix": "@param.array",
		"body": ["@param {${1:Object}[]} ${2:name} - ${3:description}"],
		"description": "An array parameter. Tab order follows reading order: element type, then name.\nhttps://jsdoc.app/tags-param\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@param is a Generic": {
		"prefix": "@param.generic",
		"body": ["@param {${1:Map}<${2:string}, ${3:number}>} ${4:name} - ${5:description}"],
		"description": "A generic parameter.\nhttps://jsdoc.app/tags-param\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@param is any type": {
		"prefix": "@param.any",
		"body": ["@param {*} ${1:name} - ${2:description}"],
		"description": "A parameter typed as `*`.\nhttps://jsdoc.app/tags-param\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@param is an Object": {
		"prefix": "@param.object",
		"body": ["@param {Object} ${1:name} - ${2:description}"],
		"description": "A parameter typed as `Object`.\nhttps://jsdoc.app/tags-param\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@param is a string": {
		"prefix": "@param.string",
		"body": ["@param {string} ${1:name} - ${2:description}"],
		"description": "A parameter typed as `string`.\nhttps://jsdoc.app/tags-param\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@param is a number": {
		"prefix": "@param.number",
		"body": ["@param {number} ${1:name} - ${2:description}"],
