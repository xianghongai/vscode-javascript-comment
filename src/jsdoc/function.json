	"@returns": {
		"prefix": ["@returns", "@return"],
		"body": ["@returns {${1:TYPE}} ${2:description}"],
		"description": "Document the return value. JSDoc lists `@return` as a synonym; this inserts the primary form.\nhttps://jsdoc.app/tags-returns\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@returns a Promise": {
		"prefix": "@returns.promise",
		"body": ["@returns {Promise<${1:TYPE}>} ${2:description}"],
		"description": "A function returning a Promise.\nhttps://jsdoc.app/tags-returns\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@throws": {
		"prefix": ["@throws", "@exception"],
		"body": ["@throws {${1:Error}} ${2:description}"],
		"description": "Describe an error a function may throw. JSDoc lists `@exception` as a synonym.\nhttps://jsdoc.app/tags-throws\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@yields": {
		"prefix": ["@yields", "@yield"],
		"body": ["@yields {${1:TYPE}} ${2:description}"],
		"description": "Document what a generator yields.\nhttps://jsdoc.app/tags-yields\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@async": {
		"prefix": "@async",
		"body": ["@async"],
		"description": "Mark a function as asynchronous.\nhttps://jsdoc.app/tags-async\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@this": {
		"prefix": "@this",
		"body": ["@this {${1:TYPE}}"],
		"description": "What `this` refers to inside a function.\nhttps://jsdoc.app/tags-this\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@requires": {
		"prefix": "@requires",
		"body": ["@requires ${1:moduleName}"],
		"description": "A module this symbol requires.\nhttps://jsdoc.app/tags-requires\n",
		"scope": "vue,javascript,javascriptreact"
	}
