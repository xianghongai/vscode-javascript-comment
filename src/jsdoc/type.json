{
	"@type": {
		"prefix": "@type",
		"body": ["@type {${1:TYPE}}"],
		"description": "The type of a variable or expression.\n`@type` takes a type expression only — no name, no description; the name comes from the declaration.\nhttps://jsdoc.app/tags-type\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@type is any type": {
		"prefix": "@type.any",
		"body": ["@type {*}"],
		"description": "Typed as `*`.\nhttps://jsdoc.app/tags-type\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@type is an Object": {
		"prefix": "@type.object",
		"body": ["@type {Object}"],
		"description": "Typed as `Object`.\nhttps://jsdoc.app/tags-type\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@type is a string": {
		"prefix": "@type.string",
		"body": ["@type {string}"],
		"description": "Typed as `string`.\nhttps://jsdoc.app/tags-type\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@type is a number": {
		"prefix": "@type.number",
		"body": ["@type {number}"],
		"description": "Typed as `number`.\nhttps://jsdoc.app/tags-type\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@type is a boolean": {
		"prefix": "@type.boolean",
		"body": ["@type {boolean}"],
