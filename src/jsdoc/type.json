		"scope": "vue,javascript,javascriptreact"
	},
	"@type is an HTMLElement": {
		"prefix": "@type.HTMLElement",
		"body": ["@type {HTMLElement}"],
		"description": "Typed as `HTMLElement`.\nhttps://jsdoc.app/tags-type\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@type is a Node": {
		"prefix": "@type.Node",
		"body": ["@type {Node}"],
		"description": "Typed as `Node`.\nhttps://jsdoc.app/tags-type\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@type is a NodeList": {
		"prefix": "@type.NodeList",
		"body": ["@type {NodeList}"],
		"description": "Typed as `NodeList`.\nhttps://jsdoc.app/tags-type\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@type is a RegExp": {
		"prefix": "@type.RegExp",
		"body": ["@type {RegExp}"],
		"description": "Typed as `RegExp`.\nhttps://jsdoc.app/tags-type\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@type is an Array": {
		"prefix": "@type.array",
		"body": ["@type {${1:Object}[]}"],
		"description": "An array type.\nhttps://jsdoc.app/tags-type\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@type is a Generic": {
		"prefix": "@type.generic",
		"body": ["@type {${1:Map}<${2:string}, ${3:number}>}"],
		"description": "A generic type.\nhttps://jsdoc.app/tags-type\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@typedef": {
		"prefix": "@typedef",
		"body": ["@typedef {${1:TYPE}} ${2:Name}"],
		"description": "Give a name to a type so it can be reused.\nhttps://jsdoc.app/tags-typedef\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@typedef object": {
		"prefix": "@typedef.object",
		"body": ["/**", " * @typedef {Object} ${1:Name}", " * @property {${2:TYPE}} ${3:name} - ${4:description}", " */"],
		"description": "A named object type, with its members described by `@property`.\nhttps://jsdoc.app/tags-typedef\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@template": {
		"prefix": "@template",
		"body": ["@template ${1:T}"],
		"description": "Declare a type parameter for a generic function or class. Supported by TypeScript in checkJs.\nhttps://www.typescriptlang.org/docs/handbook/jsdoc-supported-types.html\n",
		"scope": "vue,javascript,javascriptreact"
	},
	"@callback": {
		"prefix": "@callback",
		"body": [
			"/**",
			" * @callback ${1:Name}",
			" * @param {${2:TYPE}} ${3:name} - ${4:description}",
			" * @returns {${5:TYPE}}",
			" */"
		],
		"description": "Describe a callback function signature so it can be referenced as a type.\nhttps://jsdoc.app/tags-callback\n",
		"scope": "vue,javascript,javascriptreact"
	}
}
