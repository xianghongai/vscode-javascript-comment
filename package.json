{
  "name": "vscode-javascript-comment",
  "displayName": "JavaScript Comment Snippet",
  "version": "1.1.0",
  "description": "JSDoc comments in JavaScript and TSDoc comments in TypeScript, both triggered by `@`. JSDoc / TSDoc 注释片段。",
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "comment",
    "ecmascript",
    "es6 comment",
    "esdoc",
    "javascript",
    "javascript comment",
    "js comment",
    "jsdoc",
    "ts comment",
    "tsdoc",
    "typescript",
    "typescript comment"
  ],
  "homepage": "https://github.com/xianghongai/vscode-javascript-comment/",
  "bugs": {
    "url": "https://github.com/xianghongai/vscode-javascript-comment/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xianghongai/vscode-javascript-comment/blob/master/README.md"
  },
  "publisher": "NicholasHsiang",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "clean": "rimraf --glob \"*.vsix\" snippets",
    "dev": "node --watch-path=src scripts/build.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint scripts tests",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "test": "vitest run",
    "vscode:prepublish": "pnpm run clean && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vscode/vsce": "3.9.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "picocolors": "^1.1.1",
    "rimraf": "^6.1.3",
    "vitest": "4.1.11"
  },
  "contributes": {
    "snippets": [
      {
        "path": "./snippets/index.code-snippets"
      }
    ]
  },
  "icon": "art/icon.png",
  "galleryBanner": {
    "color": "#ffffff",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@11.25.0"
}
